# Copiar a .env.production en el servidor antes de npm run build
# Las variables VITE_* se embeben en el build (no son secretas en runtime del navegador)

VITE_MATUDB_URL=https://db.matudb.com
VITE_MATUDB_PROJECT_ID=tu-project-id
VITE_MATUDB_API_KEY=tu-api-key

# Google Sign-In (OAuth 2.0 Web Client ID)
VITE_GOOGLE_CLIENT_ID=
