# MatuDB — https://devjuanes.com
# URL base de la API (sin /api al final). Ejemplos:
#   Cloud:  http://matudb.com:3001
#   Local:  http://localhost:3001
VITE_MATUDB_URL=http://matudb.com:3001
VITE_MATUDB_PROJECT_ID=quinlist
VITE_MATUDB_API_KEY=anon_xxxx

# Google Sign-In (OAuth 2.0 Web Client ID from Google Cloud Console)
# Authorized JavaScript origins: http://localhost:5173 (dev) + your production origin
# MatuDB must expose POST /api/projects/:id/auth/oauth/google { credential }
VITE_GOOGLE_CLIENT_ID=

# Sizor SSO / embed
VITE_SIZOR_URL=https://sizor.online

# URL pública de QuinList (retorno de Landa Pay y webhooks)
APP_PUBLIC_URL=https://quinlist.matubyte.com
BILLING_PORT=4012

# Landa Pay — solo en el servidor. Nunca uses el prefijo VITE_.
# El plan VIP son $15 USD. 1500 centavos de dólar. Landa Pay lo cobra en COP a la tasa del día.
LANDAPAY_API_KEY=lp_sk_test_...
LANDAPAY_WEBHOOK_SECRET=whsec_...
LANDAPAY_VIP_CURRENCY=USD
LANDAPAY_VIP_AMOUNT=1500
# LANDAPAY_VIP_PLAN_ID=plan_...
# LANDAPAY_API_URL=https://api.landapay.co

# Asistente VIP. Compatible con la API de chat de OpenAI.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Google Analytics 4 (opcional). Ej: G-ABC123XYZ. Vacío = sin analítica.
VITE_GA_MEASUREMENT_ID=
