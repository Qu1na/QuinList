# MatuDB — https://devjuanes.com
# URL base de la API (sin /api al final). Ejemplos:
#   Cloud:  http://matudb.com:3001
#   Local:  http://localhost:3001
VITE_MATUDB_URL=http://matudb.com:3001
VITE_MATUDB_PROJECT_ID=quinlist
VITE_MATUDB_API_KEY=anon_xxxx

# Google Sign-In (OAuth 2.0 Web Client ID from Google Cloud Console)
# Authorized JavaScript origins: http://localhost:5173 (dev) + your production origin
# MatuDB must expose POST /api/projects/:id/auth/oauth/google { credential }
VITE_GOOGLE_CLIENT_ID=
